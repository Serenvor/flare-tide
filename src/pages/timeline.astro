---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getCollection } from "astro:content";
import { getPostUrlBySlug } from "@/utils/url-utils";

const title = "时序札";
const description = "以时间为脉络，串联所有落笔的记述，回望走过的朝暮。";

// ========================================
// 时间轴分类配置
// 时光轴仅显示「纪事录」分类的文章
// ========================================
const timelineCategories = {
	纪事录: true,
	书信集: false,
	情绪随笔: false,
	碎碎念: false,
};

// 获取需要显示的分类列表
const activeCategories = Object.entries(timelineCategories)
	.filter(([, enabled]) => enabled)
	.map(([cat]) => cat);

// 使用 Astro 原生 getCollection API 自动读取所有文章
const allPosts = await getCollection("posts", ({ data }) => {
	// 生产环境排除草稿
	if (import.meta.env.PROD && data.draft) return false;
	// 筛选：只保留开启了的分类
	return data.category && activeCategories.includes(data.category);
});

// 按 published 日期正序排序（由远及近，从初识往现在推进）
const sortedPosts = allPosts.sort((a, b) => {
	const dateA = new Date(a.data.published);
	const dateB = new Date(b.data.published);
	return dateA.getTime() - dateB.getTime();
});

// Extract unique year-month markers for date navigation
const dateMarkers = sortedPosts.map((post, index) => {
	const d = new Date(post.data.published);
	return {
		year: d.getFullYear(),
		month: d.getMonth() + 1,
		label: `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}`,
		index: index,
	};
});
// Deduplicate by year.month, keep first occurrence
const uniqueMarkers = dateMarkers.filter(
	(m, i, arr) => i === 0 || arr[i - 1].label !== m.label,
);

// 格式化日期
function formatDate(date: Date) {
	const year = date.getFullYear();
	const month = String(date.getMonth() + 1).padStart(2, "0");
	const day = String(date.getDate()).padStart(2, "0");
	const weekdays = ["日", "一", "二", "三", "四", "五", "六"];
	const weekday = weekdays[date.getDay()];
	return { full: `${year}.${month}.${day}`, weekday: `星期${weekday}` };
}

// 分类对应的简约图标
const categoryIcons: Record<string, string> = {
	纪事录: "📖",
	书信集: "💌",
	情绪随笔: "🫀",
	碎碎念: "✍️",
};
---

<MainGridLayout title={title} description={description}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-6 py-8 relative w-full">

      <!-- ========== 上半部分：时光轴 ========== -->
      <div class="text-center mb-6">
        <h1 class="text-3xl font-bold text-neutral-800 dark:text-neutral-100 mb-2">{title}</h1>
        <p class="text-base text-neutral-500 dark:text-neutral-400">{description}</p>
      </div>

      <div class="timeline-container relative mb-4">
        <div class="timeline-line absolute left-1/2 -translate-x-px top-0 bottom-0 w-0.5 bg-gradient-to-b from-pink-300 via-pink-400 to-pink-300 dark:from-pink-700 dark:via-pink-600 dark:to-pink-700"></div>

        {sortedPosts.length > 0 ? (
          sortedPosts.map((post, index) => {
            const { full, weekday } = formatDate(post.data.published);
            const isLeft = index % 2 === 0;
            const slug = post.id;
            const postUrl = getPostUrlBySlug(slug);
            const icon = categoryIcons[post.data.category || ""] || "📖";
            return (
              <div class={`timeline-item relative flex items-center mb-8 ${isLeft ? "flex-row" : "flex-row-reverse"}`}>
                <div class={`w-[calc(50%-1.5rem)] ${isLeft ? "pr-4 text-right" : "pl-4 text-left"}`}>
                  <a href={postUrl} class="timeline-card inline-block p-4 rounded-xl bg-white/60 dark:bg-neutral-800/60 border border-pink-100 dark:border-pink-900/30 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-0.5 max-w-full text-left no-underline group">
                    <div class="text-xs text-pink-400 dark:text-pink-500 font-medium mb-1">{full} {weekday}</div>
                    <div class="text-base font-bold text-neutral-800 dark:text-neutral-100 mb-1 group-hover:text-pink-500 dark:group-hover:text-pink-400 transition-colors">{post.data.title}</div>
                    {post.data.description && (
                      <div class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed line-clamp-2">{post.data.description}</div>
                    )}
                  </a>
                </div>
                <div class="timeline-dot absolute left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-pink-100 dark:bg-pink-900/40 border-2 border-pink-300 dark:border-pink-700 flex items-center justify-center text-sm z-10 shadow-sm">{icon}</div>
                <div class="w-[calc(50%-1.5rem)]"></div>
              </div>
            );
          })
        ) : (
          <div class="text-center py-12 text-neutral-400 dark:text-neutral-500">
            <div class="text-3xl mb-3">📭</div>
            <p class="text-sm">还没有纪事录文章</p>
            <p class="text-xs mt-1 text-neutral-300 dark:text-neutral-600">写一篇文章，它会自动出现在这里</p>
          </div>
        )}

        <div class="relative flex items-center justify-center py-4">
          <div class="timeline-dot absolute left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-pink-50 dark:bg-pink-900/20 border-2 border-dashed border-pink-300 dark:border-pink-700 flex items-center justify-center text-sm z-10">✨</div>
        </div>
      </div>

      <!-- 日期导航面板 -->
      <div id="date-nav" class="fixed right-4 top-1/2 -translate-y-1/2 z-40 hidden lg:flex flex-col gap-1 bg-white/80 dark:bg-neutral-800/80 backdrop-blur-sm rounded-xl px-2 py-3 shadow-lg border border-pink-100 dark:border-pink-900/30">
        {uniqueMarkers.map((marker) => (
          <button
            data-timeline-index={marker.index}
            class="date-nav-item text-xs px-2 py-1 rounded-lg text-neutral-500 dark:text-neutral-400 hover:text-pink-500 hover:bg-pink-50 dark:hover:bg-pink-900/20 transition-all cursor-pointer whitespace-nowrap"
          >
            {marker.label}
          </button>
        ))}
      </div>

    </div>
  </div>

  <style>
    @media (max-width: 1024px) {
      #date-nav {
        display: none !important;
      }
    }
    #date-nav .date-nav-item.active {
      color: var(--primary, #ff69b4);
      background: rgba(255, 105, 180, 0.1);
      font-weight: 600;
    }
  </style>

  <script is:inline>
    (function() {
      var items = document.querySelectorAll('.timeline-item');
      var navBtns = document.querySelectorAll('.date-nav-item');
      if (!items.length || !navBtns.length) return;

      // Click to scroll
      navBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var idx = parseInt(btn.getAttribute('data-timeline-index'));
          if (items[idx]) {
            items[idx].scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        });
      });

      // Highlight current on scroll
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            var idx = Array.from(items).indexOf(entry.target);
            navBtns.forEach(function(b) { b.classList.remove('active'); });
            if (navBtns[idx]) navBtns[idx].classList.add('active');
          }
        });
      }, { threshold: 0.5 });

      items.forEach(function(item) { observer.observe(item); });
    })();
  </script>
</MainGridLayout>
