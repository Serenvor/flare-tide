---
/**
 * 恋爱计时看板组件（v2 改造版）
 * 始于2024.07.14 · 我们同行的日子
 * 纪念日循环计算 + 呼吸动画 + 里程碑轮播 + 点击彩蛋
 */
---

<div class="love-timer-wrapper card-base p-4 md:p-6 mb-4">
  <!-- 浮动爱心装饰 -->
  <div class="floating-hearts" aria-hidden="true"></div>

  <!-- 标题 -->
  <div class="timer-header text-center mb-3">
    <div class="inline-flex items-center gap-2 mb-1">
      <span class="text-xl">💕</span>
      <span class="timer-title text-lg font-bold">始于2024.07.14 · 我们同行的日子</span>
      <span class="text-xl">💕</span>
    </div>
  </div>

  <!-- 在一起总时长 -->
  <div class="timer-total flex justify-center items-end gap-3 md:gap-6 mb-2 cursor-pointer select-none" id="timer-total-area" title="点击有惊喜~">
    <div class="timer-unit timer-unit--days">
      <div class="timer-number" id="love-days">--</div>
      <div class="timer-label">朝夕</div>
    </div>
    <div class="timer-separator">:</div>
    <div class="timer-unit timer-unit--sub">
      <div class="timer-number" id="love-hours">--</div>
      <div class="timer-label">辰光</div>
    </div>
    <div class="timer-separator">:</div>
    <div class="timer-unit timer-unit--sub">
      <div class="timer-number" id="love-minutes">--</div>
      <div class="timer-label">片刻</div>
    </div>
    <div class="timer-separator">:</div>
    <div class="timer-unit timer-unit--sub">
      <div class="timer-number" id="love-seconds">--</div>
      <div class="timer-label">瞬间</div>
    </div>
  </div>

  <!-- 底部标语 -->
  <div class="timer-slogan text-center text-xs mb-1" style="letter-spacing:0.08em;">
    时间会见证所有细碎的浪漫
  </div>

  <!-- 里程碑轮播（单行切换） -->
  <div class="milestone-marquee" id="milestone-marquee">
    <div class="milestone-text" id="milestone-text">加载中...</div>
  </div>

  <!-- 纪念日倒计时 -->
  <div class="countdown-grid grid grid-cols-2 md:grid-cols-4 gap-2 sm:gap-3 mt-4">
    <div class="countdown-item" data-month="7" data-day="14">
      <div class="countdown-icon">💑</div>
      <div class="countdown-title">我们相守之日</div>
      <div class="countdown-date">每年 07.14</div>
      <div class="countdown-value" id="cd-together">计算中...</div>
    </div>
    <div class="countdown-item" data-month="9" data-day="15">
      <div class="countdown-icon">🌹</div>
      <div class="countdown-title">初见相逢时</div>
      <div class="countdown-date">每年 09.15</div>
      <div class="countdown-value" id="cd-meeting">计算中...</div>
    </div>
    <div class="countdown-item" data-month="10" data-day="23">
      <div class="countdown-icon">🎂</div>
      <div class="countdown-title">斐君生辰</div>
      <div class="countdown-date">每年 10.23</div>
      <div class="countdown-value" id="cd-birthday-him">计算中...</div>
    </div>
    <div class="countdown-item countdown-item--lunar">
      <div class="countdown-icon">🎁</div>
      <div class="countdown-title">婷卿生辰</div>
      <div class="countdown-date">农历正月十二</div>
      <div class="countdown-value" id="cd-birthday-her">计算中...</div>
    </div>
  </div>
</div>

<!-- 彩蛋弹窗 -->
<div class="easter-egg-overlay" id="easter-egg-overlay">
  <div class="easter-egg-card">
    <div class="easter-egg-text" id="easter-egg-text"></div>
    <button class="easter-egg-close" id="easter-egg-close">💕 收到</button>
  </div>
</div>

<style>
  /* ===== 容器 ===== */
  .love-timer-wrapper {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(135deg,
        rgba(255, 240, 245, 0.82) 0%,
        rgba(255, 228, 238, 0.75) 40%,
        rgba(255, 240, 245, 0.82) 100%),
      url('/flare-tide/assets/images/timer/timer-bg.png') center / cover no-repeat;
    background-color: #fff0f5;
    border: 1px solid rgba(255, 105, 180, 0.15);
    border-radius: var(--radius-large, 1rem);
    backdrop-filter: blur(10px);
    opacity: 0;
    animation:
      timerFadeIn 400ms ease-out 50ms forwards,
      containerBreathe 6s ease-in-out 450ms infinite;
  }

  /* 背景淡粉色蒙版 */
  .love-timer-wrapper::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(255, 182, 193, 0.15);
    z-index: 0;
    pointer-events: none;
  }

  :global(.dark) .love-timer-wrapper::before {
    background: rgba(255, 105, 180, 0.1);
  }

  @keyframes timerFadeIn {
    from { opacity: 0; transform: translateY(1rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes containerBreathe {
    0%, 100% { border-color: rgba(255, 105, 180, 0.15); }
    50% { border-color: rgba(255, 105, 180, 0.28); }
  }

  :global(.dark) .love-timer-wrapper {
    background:
      linear-gradient(135deg,
        rgba(30, 20, 28, 0.85) 0%,
        rgba(40, 25, 35, 0.78) 40%,
        rgba(30, 20, 28, 0.85) 100%),
      url('/flare-tide/assets/images/timer/timer-bg.png') center / cover no-repeat;
    background-color: #1e141c;
    border-color: rgba(255, 105, 180, 0.1);
    animation:
      timerFadeIn 400ms ease-out 50ms forwards,
      containerBreatheDark 6s ease-in-out 450ms infinite;
  }

  @keyframes containerBreatheDark {
    0%, 100% { border-color: rgba(255, 105, 180, 0.1); }
    50% { border-color: rgba(255, 105, 180, 0.2); }
  }

  /* ===== 浮动爱心 ===== */
  .floating-hearts {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .float-heart {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    animation: floatUp linear infinite;
    font-size: 10px;
  }

  @keyframes floatUp {
    0% {
      opacity: 0;
      transform: translateY(0) translateX(0) scale(0.6);
    }
    15% { opacity: 0.5; }
    85% { opacity: 0.3; }
    100% {
      opacity: 0;
      transform: translateY(-100%) translateX(20px) scale(1);
    }
  }

  /* ===== 标题 ===== */
  .timer-header {
    position: relative;
    z-index: 1;
  }

  .timer-title {
    letter-spacing: 0.06em;
    color: #222222 !important;
  }

  :global(.dark) .timer-title {
    color: #f5f5f5 !important;
  }

  /* ===== 总时长数字 ===== */
  .timer-total {
    position: relative;
    z-index: 1;
    font-variant-numeric: tabular-nums;
    padding: 0.5rem 0;
  }

  .timer-total:hover .timer-number {
    filter: brightness(1.1);
  }

  .timer-unit { text-align: center; }

  .timer-number {
    font-weight: 800;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    background: linear-gradient(135deg, var(--primary, #ff69b4), color-mix(in srgb, var(--primary, #ff69b4) 80%, black));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    transition: filter 0.3s ease;
  }

  .timer-unit--days .timer-number {
    font-size: 3rem;
    min-width: 4.5rem;
  }

  .timer-unit--sub .timer-number {
    font-size: 1.6rem;
    min-width: 2rem;
  }

  .timer-separator {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--primary, #ff69b4);
    opacity: 0.4;
    align-self: flex-start;
    margin-top: 0.3rem;
    animation: blink 1s ease-in-out infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.9; }
  }

  .timer-label {
    font-size: 0.65rem;
    color: #666666 !important;
    margin-top: 0.2rem;
    letter-spacing: 0.1em;
  }

  :global(.dark) .timer-label {
    color: #aaaaaa !important;
  }

  /* ===== 标语文字 ===== */
  .timer-slogan {
    position: relative;
    z-index: 1;
    color: #555555 !important;
  }

  :global(.dark) .timer-slogan {
    color: #bbbbbb !important;
  }

  /* ===== 里程碑轮播（单行切换） ===== */
  .milestone-marquee {
    position: relative;
    z-index: 1;
    height: 1.8rem;
    margin: 0 auto 0.5rem;
    max-width: 28rem;
    text-align: center;
    overflow: hidden;
  }

  .milestone-text {
    height: 1.8rem;
    line-height: 1.8rem;
    font-size: 0.75rem;
    color: #b06080;
    white-space: nowrap;
    letter-spacing: 0.04em;
    opacity: 0.85;
    transition: opacity 0.4s ease;
  }

  :global(.dark) .milestone-text {
    color: #d8a0c0;
  }

  .milestone-text.milestone-fading {
    opacity: 0;
  }

  /* ===== 纪念日卡片 ===== */
  .countdown-item {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 0.75rem 0.5rem;
    border-radius: 0.75rem;
    background: rgba(255, 105, 180, 0.04);
    border: 1px solid rgba(255, 105, 180, 0.08);
    flex: 1 1 0;
    min-width: 0;
    transition: transform 220ms ease-out, box-shadow 220ms ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .countdown-item { transition: none; }
  }

  @media (hover: hover) and (pointer: fine) {
    .countdown-item:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(255, 105, 180, 0.18);
      border-color: rgba(255, 105, 180, 0.2);
    }
  }

  :global(.dark) .countdown-item {
    background: rgba(255, 105, 180, 0.02);
    border-color: rgba(255, 105, 180, 0.06);
  }

  .countdown-item.highlight-soon {
    background: rgba(255, 105, 180, 0.1);
    border-color: rgba(255, 105, 180, 0.2);
    animation: softGlow 3s ease-in-out infinite;
  }

  :global(.dark) .countdown-item.highlight-soon {
    background: rgba(255, 105, 180, 0.06);
    border-color: rgba(255, 105, 180, 0.15);
  }

  @keyframes softGlow {
    0%, 100% { box-shadow: 0 0 0 rgba(255, 105, 180, 0); }
    50% { box-shadow: 0 4px 20px rgba(255, 105, 180, 0.12); }
  }

  .countdown-item.is-today {
    background: linear-gradient(135deg,
      rgba(255, 105, 180, 0.15) 0%,
      rgba(255, 182, 193, 0.12) 100%);
    border-color: rgba(255, 105, 180, 0.35);
    animation: todayPulse 2s ease-in-out infinite;
  }

  :global(.dark) .countdown-item.is-today {
    background: linear-gradient(135deg,
      rgba(255, 105, 180, 0.1) 0%,
      rgba(255, 182, 193, 0.06) 100%);
    border-color: rgba(255, 105, 180, 0.25);
  }

  @keyframes todayPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.02); }
  }

  .countdown-icon {
    font-size: 1.4rem;
    margin-bottom: 0.3rem;
  }

  .countdown-title {
    font-size: clamp(0.65rem, 2vw, 0.8rem);
    font-weight: 600;
    color: #666666 !important;
    margin-bottom: 0.15rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.dark) .countdown-title {
    color: #aaaaaa !important;
  }

  .countdown-date {
    font-size: clamp(0.55rem, 1.8vw, 0.65rem);
    color: #999999 !important;
    margin-bottom: 0.3rem;
  }

  :global(.dark) .countdown-date {
    color: #888888 !important;
  }

  .countdown-value {
    font-size: clamp(0.72rem, 2.5vw, 1rem);
    font-weight: 700;
    color: var(--primary, #ff69b4);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
    line-height: 1.3;
  }

  /* ===== 倒计时hover展开（使用 :global 修复 Astro scoped CSS 对动态元素不生效的问题） ===== */
  :global(.countdown-value .cd-full) {
    display: none !important;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.countdown-item:hover .countdown-value .cd-days-only) {
      display: none !important;
    }
    :global(.countdown-item:hover .countdown-value .cd-full) {
      display: inline !important;
    }
  }

  /* 移动端点击展开 */
  :global(.countdown-item.is-expanded .countdown-value .cd-days-only) {
    display: none !important;
  }
  :global(.countdown-item.is-expanded .countdown-value .cd-full) {
    display: inline !important;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.countdown-value .cd-days-only) {
      display: none !important;
    }
    :global(.countdown-value .cd-full) {
      display: inline !important;
    }
  }

  /* ===== 彩蛋弹窗 ===== */
  .easter-egg-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(6px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .easter-egg-overlay.show {
    opacity: 1;
    pointer-events: auto;
  }

  .easter-egg-card {
    background: linear-gradient(135deg,
      rgba(255, 240, 245, 0.97) 0%,
      rgba(255, 228, 238, 0.97) 100%);
    border: 1px solid rgba(255, 105, 180, 0.25);
    border-radius: 1.2rem;
    padding: 2rem 2.5rem;
    max-width: 340px;
    text-align: center;
    box-shadow: 0 20px 60px rgba(255, 105, 180, 0.2);
    transform: scale(0.9) translateY(10px);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
                opacity 0.25s ease;
    opacity: 0;
  }

  .easter-egg-overlay.show .easter-egg-card {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  :global(.dark) .easter-egg-card {
    background: linear-gradient(135deg,
      rgba(50, 30, 40, 0.97) 0%,
      rgba(40, 20, 35, 0.97) 100%);
    border-color: rgba(255, 105, 180, 0.2);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
  }

  .easter-egg-text {
    font-size: 1rem;
    line-height: 1.8;
    color: #7a4060;
    margin-bottom: 1.2rem;
    letter-spacing: 0.04em;
  }

  :global(.dark) .easter-egg-text {
    color: #e8b0c8;
  }

  .easter-egg-close {
    background: linear-gradient(135deg, #ff8fbf, #ff69b4);
    color: white;
    border: none;
    border-radius: 2rem;
    padding: 0.5rem 1.5rem;
    font-size: 0.85rem;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    letter-spacing: 0.06em;
  }

  @media (hover: hover) and (pointer: fine) {
    .easter-egg-close:hover {
      transform: scale(1.05);
      box-shadow: 0 4px 15px rgba(255, 105, 180, 0.35);
    }
  }

  /* ===== 移动端适配 ===== */
  @media (max-width: 640px) {
    .timer-unit--days .timer-number {
      font-size: 2.2rem;
      min-width: 3rem;
    }
    .timer-unit--sub .timer-number {
      font-size: 1.3rem;
      min-width: 1.6rem;
    }
    .timer-separator {
      font-size: 1rem;
      margin-top: 0.2rem;
    }
    .timer-total { gap: 0.5rem; }
    .timer-title {
      font-size: 0.85rem !important;
      letter-spacing: 0.02em;
    }
    .countdown-item { padding: 0.6rem 0.3rem; }
    .countdown-icon { font-size: 1.2rem; }
    .countdown-title { font-size: 0.68rem; }
    .countdown-value { font-size: 0.72rem; }
    .easter-egg-card { margin: 0 1rem; padding: 1.5rem; }
    .milestone-marquee { max-width: 100%; }
  }
</style>

<script is:inline>
(function() {
  /* ===== 配置 ===== */
  var TOGETHER_DATE = new Date('2024-07-14T00:00:00+08:00');
  var MEETING_MONTH = 9;  // 0-indexed: 8 = September
  var MEETING_DAY = 15;
  var HIS_BIRTHDAY_MONTH = 9; // 0-indexed: 9 = October
  var HIS_BIRTHDAY_DAY = 23;

  // 她的农历生日（正月十二）→ 公历对照表
  var LUNAR_BIRTHDAY_HER = [
    { year: 2024, month: 1, day: 21 },
    { year: 2025, month: 0, day: 29 },
    { year: 2026, month: 1, day: 17 },
    { year: 2027, month: 1, day: 6 },
    { year: 2028, month: 1, day: 25 },
    { year: 2029, month: 1, day: 14 },
    { year: 2030, month: 1, day: 4 },
    { year: 2031, month: 1, day: 23 },
    { year: 2032, month: 1, day: 12 },
    { year: 2033, month: 1, day: 31 },
  ];

  /* ===== 温柔短句库 ===== */
  var sweetQuotes = [
    '你是我写过最美的情书。',
    '遇见你之后，人间万物都变得温柔。',
    '你笑的时候，我心里的花全都开了。',
    '想把所有的晚安都攒起来说给你听。',
    '你是我所有不安的解药。',
    '和你在一起，连沉默都是浪漫。',
    '世间万物，唯你最珍贵。',
    '喜欢你这件事，我打算坚持一辈子。',
    '你是我藏在心底最甜的秘密。',
    '余生很长，我只想和你慢慢走。',
    '你的名字，是我读过最短的情诗。',
    '我想把所有温柔都留给你。',
    '遇见你，是我所有故事的开始。',
    '你是我平淡生活里的星辰大海。',
    '今天的风好温柔，像你一样。',
    '你是我心动的开始，也是余生的归宿。',
  ];

  /* ===== 工具函数 ===== */
  function pad(n) { return n < 10 ? '0' + n : '' + n; }

  function isSameDay(d1, d2) {
    return d1.getFullYear() === d2.getFullYear()
      && d1.getMonth() === d2.getMonth()
      && d1.getDate() === d2.getDate();
  }

  // 获取某个固定日期的下一个周年纪念日（含今天）
  function getNextAnniversary(month0, day) {
    var now = new Date();
    var year = now.getFullYear();
    var target = new Date(year, month0, day, 0, 0, 0);
    // 如果今年的还没到，用今年的；如果已经过了（不含当天），用明年的
    var todayStart = new Date(year, now.getMonth(), now.getDate(), 0, 0, 0);
    var targetDateOnly = new Date(year, month0, day, 0, 0, 0);
    if (targetDateOnly < todayStart) {
      target = new Date(year + 1, month0, day, 0, 0, 0);
    }
    return target;
  }

  // 获取最近一次农历生日（公历日期）
  function getHerNextBirthday() {
    var now = new Date();
    var currentYear = now.getFullYear();
    var todayStart = new Date(currentYear, now.getMonth(), now.getDate(), 0, 0, 0);

    for (var i = 0; i < LUNAR_BIRTHDAY_HER.length; i++) {
      var b = LUNAR_BIRTHDAY_HER[i];
      if (b.year >= currentYear) {
        var next = new Date(b.year, b.month, b.day, 0, 0, 0);
        if (next >= todayStart) return next;
      }
    }
    // fallback: 用近似周期估算
    var last = LUNAR_BIRTHDAY_HER[LUNAR_BIRTHDAY_HER.length - 1];
    return new Date(last.year + 1, last.month, last.day, 0, 0, 0);
  }

  // 计算倒计时：返回 { days, hours, minutes, seconds }
  function calcCountdown(target) {
    var now = new Date();
    var diff = target.getTime() - now.getTime();
    // 1分钟内的误差视为当天
    if (diff < -60000) return null; // 已过
    if (diff <= 0) return { days: 0, hours: 0, minutes: 0, seconds: 0, isZero: true };

    var totalSeconds = Math.floor(diff / 1000);
    var days = Math.floor(totalSeconds / 86400);
    var hours = Math.floor((totalSeconds % 86400) / 3600);
    var minutes = Math.floor((totalSeconds % 3600) / 60);
    var seconds = totalSeconds % 60;
    return { days: days, hours: hours, minutes: minutes, seconds: seconds, isZero: false };
  }

  // 格式化倒计时文案（含全部单位）
  function formatFullCountdown(cd) {
    if (!cd) return '已过';
    if (cd.isZero) return '🎉 今天！';
    if (cd.days > 0) return cd.days + '天' + pad(cd.hours) + '时' + pad(cd.minutes) + '分' + pad(cd.seconds) + '秒';
    if (cd.hours > 0) return pad(cd.hours) + '时' + pad(cd.minutes) + '分' + pad(cd.seconds) + '秒';
    return pad(cd.minutes) + '分' + pad(cd.seconds) + '秒';
  }

  // 格式化仅显示天数的倒计时
  function formatDaysOnlyCountdown(cd) {
    if (!cd) return '已过';
    if (cd.isZero) return '🎉 今天！';
    return cd.days + '天';
  }

  /* ===== 更新纪念日卡片 ===== */
  function updateCountdownCard(el, month0, day, isLunar, lunarDate) {
    if (!el) return;
    var now = new Date();
    var todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0);

    var target;
    if (isLunar && lunarDate) {
      target = lunarDate;
    } else {
      target = getNextAnniversary(month0, day);
    }

    // 判断是否是今天
    if (isSameDay(target, now)) {
      el.classList.add('is-today');
      el.classList.remove('highlight-soon');
      // 计算第几周年
      var baseYear = isLunar ? lunarDate.getFullYear() : 2024;
      var yearsDiff;
      if (isLunar) {
        // 农历：找原始年份
        for (var k = 0; k < LUNAR_BIRTHDAY_HER.length; k++) {
          if (LUNAR_BIRTHDAY_HER[k].year === target.getFullYear()) {
            baseYear = LUNAR_BIRTHDAY_HER[k].year;
            break;
          }
        }
        yearsDiff = now.getFullYear() - baseYear + 1;
      } else {
        yearsDiff = now.getFullYear() - 2024 + (month0 >= 6 ? 1 : 1);
        // 更精确：用第一次发生的年份
        if (month0 === 6 && day === 14) yearsDiff = now.getFullYear() - 2024 + 1;
        else if (month0 === 8 && day === 15) yearsDiff = now.getFullYear() - 2024 + 1;
        else if (month0 === 9 && day === 23) yearsDiff = now.getFullYear() - 2024 + 1;
      }
      var suffix = yearsDiff <= 1 ? '' : '第' + yearsDiff + '年 ';
      el.querySelector('.countdown-value').textContent = '❤️ ' + suffix + '今日纪念日';
      return;
    }

    el.classList.remove('is-today');

    var cd = calcCountdown(target);
    if (!cd) {
      el.querySelector('.countdown-value').textContent = '计算中...';
      return;
    }

    // 不足30天高亮
    if (cd.days <= 30 && !cd.isZero) {
      el.classList.add('highlight-soon');
    } else {
      el.classList.remove('highlight-soon');
    }

    // 同时设置两个版本：默认显示天数，hover显示完整
    var daysOnly = formatDaysOnlyCountdown(cd);
    var fullText = formatFullCountdown(cd);
    var valueEl = el.querySelector('.countdown-value');
    if (valueEl) {
      valueEl.innerHTML = '<span class="cd-days-only">' + daysOnly + '</span><span class="cd-full">' + fullText + '</span>';
    }
  }

  /* ===== 里程碑轮播 ===== */
  function getMilestones() {
    var now = new Date();
    var totalDiff = now.getTime() - TOGETHER_DATE.getTime();
    var totalDays = Math.floor(totalDiff / 86400000);
    var milestones = [];
    var targets = [100, 200, 300, 365, 500, 520, 600, 700, 730, 800, 900, 1000, 1314, 1500, 2000];

    for (var i = 0; i < targets.length; i++) {
      var t = targets[i];
      if (totalDays < t) {
        var left = t - totalDays;
        milestones.push('距离相恋 ' + t + ' 天还有 ' + left + ' 天');
        if (milestones.length >= 4) break;
      }
    }

    // 如果里程碑不足4条，补充纪念日提醒
    if (milestones.length < 4) {
      var events = [
        { m: 6, d: 14, name: '相守纪念日' },
        { m: 8, d: 15, name: '初见纪念日' },
        { m: 9, d: 23, name: '斐君生辰' },
      ];
      for (var j = 0; j < events.length && milestones.length < 4; j++) {
        var next = getNextAnniversary(events[j].m, events[j].d);
        var eCd = calcCountdown(next);
        if (eCd) {
          milestones.push('距离 ' + events[j].name + ' 还有 ' + eCd.days + ' 天');
        }
      }
    }

    // 至少保证2条
    if (milestones.length === 0) {
      milestones.push('在一起第 ' + totalDays + ' 天 💕');
      milestones.push('每一天都值得纪念');
    }

    return milestones;
  }

  function renderMilestones() {
    var textEl = document.getElementById('milestone-text');
    if (!textEl) return;
    var milestones = getMilestones();
    if (milestones.length === 0) return;

    // 存储到全局供定时器使用
    window.__milestoneList = milestones;
    window.__milestoneIdx = 0;

    // 显示第一条
    textEl.textContent = milestones[0];

    // 每3秒切换一条，带淡入淡出
    if (window.__milestoneTimer) clearInterval(window.__milestoneTimer);
    window.__milestoneTimer = setInterval(function () {
      var idx = window.__milestoneIdx;
      var list = window.__milestoneList;
      if (!list || list.length === 0) return;

      // 淡出
      textEl.classList.add('milestone-fading');

      setTimeout(function () {
        // 切换文字
        window.__milestoneIdx = (idx + 1) % list.length;
        textEl.textContent = list[window.__milestoneIdx];
        // 淡入
        textEl.classList.remove('milestone-fading');
      }, 400); // 与 CSS transition 时长匹配
    }, 3000);
  }

  /* ===== 浮动爱心 ===== */
  function initFloatingHearts() {
    var container = document.querySelector('.floating-hearts');
    if (!container) return;
    var hearts = ['♥', '♡', '❤', '💕'];
    var count = 6;

    for (var i = 0; i < count; i++) {
      var el = document.createElement('span');
      el.className = 'float-heart';
      el.textContent = hearts[i % hearts.length];
      el.style.left = (10 + Math.random() * 80) + '%';
      el.style.bottom = (-5 + Math.random() * 10) + '%';
      el.style.fontSize = (8 + Math.random() * 6) + 'px';
      el.style.animationDuration = (10 + Math.random() * 10) + 's';
      el.style.animationDelay = (Math.random() * 12) + 's';
      el.style.color = 'rgba(255, 105, 180, ' + (0.15 + Math.random() * 0.2) + ')';
      container.appendChild(el);
    }
  }

  /* ===== 彩蛋 ===== */
  function showEasterEgg() {
    var overlay = document.getElementById('easter-egg-overlay');
    var textEl = document.getElementById('easter-egg-text');
    if (!overlay || !textEl) return;
    textEl.textContent = sweetQuotes[Math.floor(Math.random() * sweetQuotes.length)];
    overlay.classList.add('show');
  }

  function hideEasterEgg() {
    var overlay = document.getElementById('easter-egg-overlay');
    if (overlay) overlay.classList.remove('show');
  }

  /* ===== 主更新函数 ===== */
  function updateTimer() {
    var now = new Date();
    var totalDiff = now.getTime() - TOGETHER_DATE.getTime();
    if (totalDiff < 0) totalDiff = 0;

    var totalSeconds = Math.floor(totalDiff / 1000);
    var totalDays = Math.floor(totalSeconds / 86400);
    var hours = Math.floor((totalSeconds % 86400) / 3600);
    var minutes = Math.floor((totalSeconds % 3600) / 60);
    var seconds = totalSeconds % 60;

    var dEl = document.getElementById('love-days');
    var hEl = document.getElementById('love-hours');
    var mEl = document.getElementById('love-minutes');
    var sEl = document.getElementById('love-seconds');

    if (dEl) dEl.textContent = totalDays;
    if (hEl) hEl.textContent = pad(hours);
    if (mEl) mEl.textContent = pad(minutes);
    if (sEl) sEl.textContent = pad(seconds);

    // 纪念日倒计时
    updateCountdownCard(
      document.querySelector('[data-month="7"][data-day="14"]'),
      6, 14
    );
    updateCountdownCard(
      document.querySelector('[data-month="9"][data-day="15"]'),
      8, 15
    );
    updateCountdownCard(
      document.querySelector('[data-month="10"][data-day="23"]'),
      9, 23
    );
    updateCountdownCard(
      document.querySelector('.countdown-item--lunar'),
      null, null, true, getHerNextBirthday()
    );
  }

  /* ===== 初始化 ===== */
  initFloatingHearts();
  renderMilestones();
  updateTimer();
  setInterval(updateTimer, 1000);

  // 里程碑每5分钟刷新（避免频繁DOM操作）
  setInterval(renderMilestones, 300000);

  // 彩蛋事件绑定
  var timerArea = document.getElementById('timer-total-area');
  if (timerArea) timerArea.addEventListener('click', showEasterEgg);

  var closeBtn = document.getElementById('easter-egg-close');
  if (closeBtn) closeBtn.addEventListener('click', hideEasterEgg);

  var overlayEl = document.getElementById('easter-egg-overlay');
  if (overlayEl) {
    overlayEl.addEventListener('click', function(e) {
      if (e.target === overlayEl) hideEasterEgg();
    });
  }

  // 移动端倒计时点击展开/收起
  function initMobileCountdownToggle() {
    var countdownItems = document.querySelectorAll('.countdown-item');
    countdownItems.forEach(function(item) {
      item.addEventListener('click', function() {
        // 仅移动端生效
        if (window.innerWidth >= 768) return;
        // 切换展开状态
        this.classList.toggle('is-expanded');
      });
    });
  }
  initMobileCountdownToggle();

  // Swup 页面切换后重新初始化
  window.addEventListener('swup:contentReplaced', function() {
    initMobileCountdownToggle();
  });
})();
</script>
