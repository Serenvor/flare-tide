---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}
const { class: className, style } = Astro.props;
---

<WidgetLayout name="💬 随机语录" showTitle={true} id="random-quote" class={className} style={style}>
  <div class="random-quote-box text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed italic min-h-[3rem] cursor-pointer select-none" title="点击切换语录">
    加载中...
  </div>
</WidgetLayout>

<script is:inline>
(function() {
  if (window.__randomQuoteTimer) {
    clearInterval(window.__randomQuoteTimer);
    window.__randomQuoteTimer = null;
  }

  var quotes = [
    { text: "遇见你之前，我没想过结婚。", author: "zf" },
    { text: "你笑的时候，全世界都在发光。", author: "ltt" },
    { text: "我想和你一起慢慢变老。", author: "zf" },
    { text: "今天的风好温柔，像你一样。", author: "ltt" },
    { text: "你是我所有不安的解药。", author: "zf" },
    { text: "喜欢你这件事，我打算坚持一辈子。", author: "ltt" },
    { text: "你是我藏在心底的秘密。", author: "zf" },
    { text: "有你的日子，连呼吸都是甜的。", author: "ltt" },
    { text: "我想把所有温柔都留给你。", author: "zf" },
    { text: "和你在一起的每一天都值得纪念。", author: "ltt" },
  ];

  var lastIndex = -1;
  var INTERVAL_MS = 10000;

  function showRandom() {
    // 使用 querySelectorAll 更新所有实例（桌面侧栏 + 移动端底部）
    var els = document.querySelectorAll('.random-quote-box');
    if (!els.length) return;
    var idx;
    do { idx = Math.floor(Math.random() * quotes.length); } while (idx === lastIndex && quotes.length > 1);
    lastIndex = idx;
    var q = quotes[idx];
    var html = '<span class="text-pink-400">「</span>' + q.text + '<span class="text-pink-400">」</span><br/><span class="text-xs text-neutral-400 not-italic mt-1 block text-right">—— ' + q.author + '</span>';
    els.forEach(function(el) { el.innerHTML = html; });
  }

  function startAutoRefresh() {
    if (window.__randomQuoteTimer) {
      clearInterval(window.__randomQuoteTimer);
    }
    window.__randomQuoteTimer = setInterval(showRandom, INTERVAL_MS);
  }

  showRandom();
  startAutoRefresh();

  var boxes = document.querySelectorAll('.random-quote-box');
  boxes.forEach(function(box) {
    box.addEventListener('click', function() {
      showRandom();
      startAutoRefresh();
    });
  });
})();
</script>
